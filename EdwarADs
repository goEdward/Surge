[Rule]
DOMAIN-SUFFIX,edward666.xyz,DIRECT
DOMAIN,api.immtel.co,DIRECT
DOMAIN-KEYWORD,paypal,DIRECT

# 新浪财经 *.sina.com.cn, *.sina.cn
DOMAIN,sax.sina.com.cn,REJECT
DOMAIN,sax.sina.com.hk,REJECT
DOMAIN-SUFFIX,ad.sina.com.cn,REJECT
DOMAIN-SUFFIX,ad4.sina.com.cn,REJECT
DOMAIN-SUFFIX,adbox.sina.com.cn,REJECT
DOMAIN-SUFFIX,dcads.sina.com.cn,REJECT
DOMAIN-SUFFIX,saxn.sina.com.cn,REJECT
DOMAIN-SUFFIX,saxs.sina.com.cn,REJECT
DOMAIN-SUFFIX,sdkapp.mobile.sina.cn,REJECT
DOMAIN-SUFFIX,sdkclick.mobile.sina.cn,REJECT
DOMAIN-SUFFIX,adimg.mobile.sina.cn,REJECT

# 微博开屏广告
DOMAIN-SUFFIX,biz.weibo.com,REJECT,extended-matching
# 微博拦截HTTPDNS
DOMAIN,dns.weibo.cn,REJECT,extended-matching
IP-CIDR,39.97.130.51/32,REJECT,no-resolve
IP-CIDR,39.97.128.148/32,REJECT,no-resolve
URL-REGEX,"^http:\/\/api\.weibo\.cn\/2\/httpdns\/config",REJECT,extended-matching
URL-REGEX,"^http:\/\/api\.weibo\.cn\/httpdns\/config",REJECT,extended-matching

[Map Local]
# 豆瓣 //api.douban.com, img3.doubanio.com, qnmob3.doubanio.com
^https:\/\/api\.douban\.com\/v2\/app_ads\/splash\w+ data-type=text data="{}" status-code=200
^https:\/\/(?:img|qnmob)3\.doubanio\.com\/view\/dale-online\/dale_ad\/public\/\w+ data-type=text data="{}" status-code=200

# 小佩宠物 api.petkit.cn
^https?:\/\/api\.petkit\.cn\/6\/\/device\/relatedProductsInfo data-type=text data="{}" status-code=200
# 二柄 erbingeditor.diershoubing.com
^https:\/\/erbingeditor\.diershoubing\.com\/4\/ data-type=text data="{}" status-code=200
# NGA g1.tagtic.cn
^https:\/\/g1\.tagtic\.cn data-type=text data="{}" status-code=200
# 懂球帝 ap.dongqiudi.com,ap.dongdianqiu.com
^https?:\/\/ap\.dongqiudi\.com\/plat\/v data-type=text data="{}" status-code=200
^https?:\/\/ap\.dongdianqiu\.com\/plat data-type=text data="{}" status-code=200

# 招商银行 webappcfg.paas.cmbchina.com,az1mbasecc.bas.cmbchina.com
# ^https?:\/\/webappcfg\.paas\.cmbchina\.com\/v\d\/func\/getmarketconfig data-type=text data="{}" status-code=200
# ^https?:\/\/az1mbasecc\.bas\.cmbchina\.com\/Edge\/api\/mlife\.clientface\.clientservice\.api\.advertiseService\/preCacheAdvertiseSec data-type=text data="{}" status-code=200

# 金十数据 jad-api.jin10.com
^https?:\/\/jad-api\.jin10\.com\/ad data-type=text data="{}" status-code=200

# 微博开屏广告 //*.uve.weibo.com
^https:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime data-type=text data="{}" status-code=200

^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(?:get-lbs-cell-info\.php|sdkconfig\.php) data-type=text data="{}" status-code=200

[URL Rewrite]
# 新浪财经 ad.cj.sina.cn
^https?:\/\/ad\.cj\.sina\.cn\/(osa\/adpreload|fax\/impress) - reject

[Script]

[MITM]
hostname = %APPEND% jad-api.jin10.com, ap.dongqiudi.com, ap.dongdianqiu.com, webappcfg.paas.cmbchina.com, az1mbasecc.bas.cmbchina.com, g1.tagtic.cn, erbingeditor.diershoubing.com,api.petkit.cn, *.uve.weibo.com, ad.cj.sina.cn, api.douban.com, img3.doubanio.com, qnmob3.doubanio.com
